# ── MODE ───────────────────────────────────────────────
# mock = deterministic fictional data, no credentials needed
# live = real providers (falls back to mock per-provider when a key is missing)
DATA_MODE=mock

# ── AI ─────────────────────────────────────────────────
# openai | gemini | mock   (mock = deterministic tool-calling analyst, no key)
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# ── BALLDONTLIE ────────────────────────────────────────
BALLDONTLIE_API_KEY=

# ── SPORTS DATA IO ─────────────────────────────────────
SPORTSDATAIO_API_KEY=

# ── SPORTRADAR ─────────────────────────────────────────
SPORTRADAR_API_KEY=

# ── ODDS ───────────────────────────────────────────────
THE_ODDS_API_KEY=

# ── YAHOO (OAuth 2.0) ──────────────────────────────────
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# ── RESEARCH ───────────────────────────────────────────
EXA_API_KEY=

# ── SUPABASE ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── APP ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3600

# ── ADMIN (internal tools: /admin/*) ───────────────────
# Dev: admin pages are open locally. Production: they 404 unless ADMIN_TOKEN is set
# AND the request carries cookie fs_admin=<ADMIN_TOKEN>. Replace with real auth later.
ADMIN_TOKEN=

# Sleeper's public read API needs no secret.
